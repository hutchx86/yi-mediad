# h51ga (Yi ... ; gc2053, module gc2053_mipi): the stock rmm pipeline upscales
# the sensor's ~1080p output to 2304x1296, which adds no detail and spends ~44%
# more pixels/bitrate on interpolation. Run mediad at the sensor's native
# 1920x1080 instead (the gc2053 driver exposes a 1920x1080 mode, so no scaling
# and no crop shim). Update model_table's h51ga HIGH to match.
export MEDIAD_CAP_W=1920
export MEDIAD_CAP_H=1080
export MEDIAD_PIC_W=1920
export MEDIAD_PIC_H=1080
