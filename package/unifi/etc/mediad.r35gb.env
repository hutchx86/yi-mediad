# r35gb (Yi Dome Guard, gc2053): loaded by mediad.sh after mediad.env.
# The sensor mode is 1936x1096 (stock rmm's gc2053 entry: 1936x1096@20, WDR 2).
# Stock output is 1920x1080. The clean encoder stalls on an encoder-side crop
# (1 s VE timeout per frame), and a capture-side 1920x1080 window corrupts the
# top-left of the picture. So encode the native size and show 1920x1080 via
# SPS cropping (MEDIAD_OUT_*). Verified on an r35gb, 2026-09-24.
export MEDIAD_CAP_W=1936
export MEDIAD_CAP_H=1096
export MEDIAD_PIC_W=1936
export MEDIAD_PIC_H=1096
export MEDIAD_OUT_W=1920
export MEDIAD_OUT_H=1080
