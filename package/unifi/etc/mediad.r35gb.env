# r35gb (Yi Dome Guard, gc2053): loaded by mediad.sh after mediad.env.
# The sensor mode is 1936x1096 (stock rmm's gc2053 entry: 1936x1096@20, WDR 2)
# and its margin is garbage (white x=0-1, corrupt y=0-2, white right edge).
# Encoding the native size and showing 1920x1080 via SPS crop leaves that margin
# in the coded frame, and Protect's live view ignores the crop (white line at
# top+left). A capture-side 1920x1080 window defaults to offset (0,0), which
# keeps the margin. So crop 1920x1080 at (8,8) in the VIPP, before LBC, with
# vin_crop_shim (VIDIOC_S_SELECTION), and encode that directly: no scaler, no
# SPS crop. Verified on an r35gb in Protect live view, 2026-09-26.
export MEDIAD_CAP_W=1920
export MEDIAD_CAP_H=1080
export MEDIAD_PIC_W=1920
export MEDIAD_PIC_H=1080
export VINCROP=8,8,1920,1080
export LD_PRELOAD="$UNIFI_PREFIX/lib/vin_crop_shim.so"
