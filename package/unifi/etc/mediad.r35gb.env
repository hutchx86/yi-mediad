# r35gb (Yi Dome Guard, gc2053; loaded after mediad.env): the 1936x1096 mode has
# a garbage margin, so vin_crop_shim crops 1920x1080 at (8,8) in the VIPP.
export MEDIAD_CAP_W=1920
export MEDIAD_CAP_H=1080
export MEDIAD_PIC_W=1920
export MEDIAD_PIC_H=1080
export VINCROP=8,8,1920,1080
export LD_PRELOAD="$UNIFI_PREFIX/lib/vin_crop_shim.so"
