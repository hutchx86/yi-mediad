# y291ga (gc2053 "H31ga" variant; module gc2053_mipi_H31ga_down_fps_20210323):
# the 1936x1096 mode has an 8px margin, so crop 1920x1080 at (8,8) in the VIPP
# (before LBC) via vin_crop_shim and encode 1920x1080 directly (no scaler).
# Encoding the full 1936x1096 and letting the encoder scale it to 1920x1080
# stalls ~1 s/frame on this part (476 SLOW encodes observed live 2026-10-02);
# the crop path runs at the full 20 fps.
export MEDIAD_CAP_W=1920
export MEDIAD_CAP_H=1080
export MEDIAD_PIC_W=1920
export MEDIAD_PIC_H=1080
export VINCROP=8,8,1920,1080
export LD_PRELOAD=/tmp/sd/unifi/lib/vin_crop_shim.so
